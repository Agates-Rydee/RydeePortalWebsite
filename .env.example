# Copy this file to `.env` in the project root before running `npm run dev`.
# Both variables below are required — a missing or misconfigured value causes
# the environment error screen to render instead of the application.
# Environment variables are only read at Vite startup; restart the dev server
# after any edit here.

# Base URL for every backend API call. Must parse as an http:// or https://
# URL. Individual endpoint paths are hard-coded in src/lib/config.ts and
# appended to this base. Use http://localhost:3000 when the mock service
# worker handles requests locally.
VITE_API_BASE_URL=http://localhost:3000

# Enables the in-browser mock service worker in development. Must be the
# literal string `true` or `false` — any other value is rejected.
VITE_ENABLE_MSW=true
