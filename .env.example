# Copy this file to `.env` in the project root before running `npm run dev`.
# Environment variables are only read at Vite startup; restart the dev server
# after any edit here.

# ─────────────────────────────────────────────────────────────────────────
# Mode (a) — DEFAULT: MSW mock backend (no network, no backend needed)
#
# When VITE_ENABLE_MSW=true the base URL may be omitted entirely and is
# ignored if present — mock handlers always match same-origin relative
# paths regardless of what VITE_API_BASE_URL contains.
# ─────────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000
VITE_ENABLE_MSW=true

# ─────────────────────────────────────────────────────────────────────────
# Mode (b) — Dev-server proxy to the LIVE backend (bypasses broken CORS)
#
# The Vite dev server proxies configured path prefixes (/user, /register,
# /GetAll) to VITE_DEV_PROXY_TARGET. The browser stays same-origin so no
# preflight is needed. Session cookies are rewritten to `localhost`.
#
# The AWS API Gateway stage path (`/prod`) belongs in the TARGET value —
# http-proxy prepends target-path to request-path (e.g. /user/login →
# https://<host>/prod/user/login upstream). Do not add path rewriting.
#
# The dev-server port is irrelevant in this mode (browser talks to the
# dev server directly; upstream sees only rewritten headers).
#
#   VITE_API_BASE_URL=
#   VITE_ENABLE_MSW=false
#   VITE_DEV_PROXY_TARGET=https://<api-id>.execute-api.<region>.amazonaws.com/prod

# ─────────────────────────────────────────────────────────────────────────
# Mode (c) — Direct absolute URL (production-style; requires working CORS)
#
# The browser calls the backend directly. Currently NOT viable for the
# live AWS API Gateway because its CORS is broken (missing OPTIONS
# preflight, quoted literal values in Access-Control-Allow-Headers).
# Use Mode (b) for live-backend development instead.
#
#   VITE_API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com/prod
#   VITE_ENABLE_MSW=false
